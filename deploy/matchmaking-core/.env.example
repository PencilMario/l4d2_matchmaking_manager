# File containing only the Core management bearer token (mode 0600 recommended).
CORE_API_TOKEN_FILE_HOST=/etc/l4d2-matchmaking/core-api-token

# File containing a 32-byte Base64 key used to encrypt optional server RCON passwords (mode 0600 recommended).
CORE_RCON_ENCRYPTION_KEY_FILE_HOST=/etc/l4d2-matchmaking/core-rcon-encryption-key

# PostgreSQL password for this local deployment. Use a unique random value.
POSTGRES_PASSWORD=

# Existing Linux host directory shared by every managed Agent for Steam app content.
CORE_SHARED_LIBRARY_HOST_PATH=/mnt/storage/l4d2-steam-library

# Path visible inside each Agent container. Set it after installing AppID 550 in the shared library.
CORE_AGENT_STEAM_API_LIBRARY_PATH=

# Use always temporarily to show Steam UI again for reauthentication, then restore auto.
CORE_AGENT_STEAM_LOGIN_UI_MODE=auto

# Keep the Core and managed Agent image tags explicit when using a private registry.
CORE_IMAGE=l4d2-matchmaking-core:local
CORE_AGENT_IMAGE=l4d2-steam-lobby-agent:local

# Core and all managed Agents must use the same dedicated Docker network.
CORE_AGENT_NETWORK=l4d2-matchmaking

# Core API is bound to loopback. Access it through SSH forwarding when remote.
CORE_HTTP_PORT=18080

# Dynamic Agent noVNC ports are also bound to loopback by Core.
CORE_NOVNC_PORT_START=18083
CORE_NOVNC_PORT_END=18183
