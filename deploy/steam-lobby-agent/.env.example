# Absolute Linux host directory shared by every lobby agent for Steam app content.
# This directory contains depots and app manifests, never Steam account credentials.
STEAM_SHARED_LIBRARY_HOST_PATH=/mnt/storage/l4d2-steam-library

# Set after AppID 550's Linux files are installed in the shared Steam library.
STEAM_API_LIBRARY_PATH=
# Optional Steam download region, stored only in this Agent account's config.vdf.
STEAM_DOWNLOAD_REGION=

# auto: UI only before the account's first successful login; always: force it for reauthentication; never: suppress it.
STEAM_LOGIN_UI_MODE=auto
